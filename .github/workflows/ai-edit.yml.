name: AI Code Editor (Direct Push)
on:
  issues:
    types: [labeled]

permissions:
  contents: write
  issues: write

jobs:
  edit-and-push:
    runs-on: ubuntu-latest
    if: github.event.label.name == 'ai-task'
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        
      - name: Setup Node.js (if JavaScript project)
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          
      # - name: Setup Python (if Python project)
      #   uses: actions/setup-python@v5
      #   with:
      #     python-version: '3.11'

      - name: Generate code with Groq AI
        uses: Manav916/llm-code-review@main
        with:
          groq_api_key: ${{ secrets.GROQ_API_KEY }}
          groq_model: 'llama3-70b-8192'
          github_token: ${{ secrets.GITHUB_TOKEN }}
          repo_owner: ${{ github.repository_owner }}
          repo_name: ${{ github.event.repository.name }}
          event_number: ${{ github.event.issue.number }}
          event_name: ${{ github.event_name }}

      - name: Install dependencies (if package.json exists)
        run: |
          if [ -f "package.json" ]; then
            npm install
          fi
          
      - name: Run tests (if tests exist)
        run: |
          if [ -f "package.json" ]; then
            npm test || echo "Tests failed"
          fi
        continue-on-error: false  # Stops if tests fail

      - name: Configure Git
        run: |
          git config --global user.name "AI Bot"
          git config --global user.email "ai-bot@github.com"

      - name: Check if there are changes
        id: changes
        run: |
          if [[ -n $(git status -s) ]]; then
            echo "has_changes=true" >> $GITHUB_OUTPUT
          else
            echo "has_changes=false" >> $GITHUB_OUTPUT
          fi

      - name: Commit and push directly to main
        if: steps.changes.outputs.has_changes == 'true'
        run: |
          git add .
          git commit -m "🤖 AI update for #${{ github.event.issue.number }}: ${{ github.event.issue.title }}"
          git push origin main

      - name: Close issue automatically
        if: success()
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.update({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: ${{ github.event.issue.number }},
              state: 'closed'
            })

      - name: Comment on issue if failed
        if: failure()
        uses: actions/github-script@v7
        with:
          script: |
            github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: ${{ github.event.issue.number }},
              body: '❌ AI edit failed. Check the Actions tab for details.'
            })
